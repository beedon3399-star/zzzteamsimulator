<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ゼンゼロ 9チーム編成ツール</title>
<style>
:root{
  color-scheme:dark;
  --bg:#101218;
  --panel:#181b24;
  --card:#202430;
  --line:#3a4050;
  --text:#f4f5f7;
  --muted:#aeb4c2;
  --accent:#8ab4ff;
  --accentbg:#263653;
  --danger:#ff8c8c
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:system-ui,-apple-system,BlinkMacSystemFont,
    "Segoe UI","Noto Sans JP",sans-serif
}
button,input,select{font:inherit}
button{color:inherit}
main{max-width:1100px;margin:auto;padding:24px 16px 40px}
h1{font-size:24px;margin:0 0 6px}
.sub{color:var(--muted);font-size:14px;margin-bottom:18px}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
input,select{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:9px;
  padding:10px 12px;
  color:var(--text);
  min-height:42px
}
input{flex:1;min-width:200px}
button{
  border:1px solid var(--line);
  background:var(--panel);
  border-radius:9px;
  padding:9px 12px;
  cursor:pointer
}
button:hover{border-color:#65708a}
button:focus-visible,input:focus-visible,select:focus-visible{
  outline:2px solid var(--accent);
  outline-offset:2px
}
.primary{background:var(--accentbg);border-color:#5777aa}
.notice{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:10px;
  padding:10px 12px;
  color:var(--muted);
  font-size:13px;
  margin-bottom:16px
}
.teams{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  margin-bottom:22px
}
.team{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:13px;
  padding:12px
}
.team.active{
  border-color:var(--accent);
  box-shadow:0 0 0 1px var(--accent)
}
.teamhead{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:10px
}
.teamhead b{font-size:15px}
.slots{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:7px
}
.slot{
  min-height:105px;
  padding:5px;
  font-size:12px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  background:#171a22;
  overflow:hidden
}
.slot.empty{
  color:var(--muted);
  border-style:dashed
}
.slot img{
  width:58px;
  height:58px;
  object-fit:cover;
  border-radius:9px;
  margin-bottom:4px;
  background:#303746
}
.slot .initial{
  font-size:21px;
  font-weight:700;
  margin-bottom:3px
}
.slot .spec{
  font-size:10px;
  color:var(--muted);
  margin-top:2px
}
.filters{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:12px
}
.count{
  color:var(--muted);
  font-size:13px;
  margin:8px 0
}
.chars{
  display:grid;
  grid-template-columns:repeat(7,minmax(0,1fr));
  gap:8px
}
.char{
  min-height:118px;
  padding:7px 5px;
  font-size:12px;
  text-align:center;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center
}
.char.used{
  opacity:.38;
  cursor:not-allowed
}
.char img{
  width:58px;
  height:58px;
  object-fit:cover;
  border-radius:9px;
  background:#303746;
  margin-bottom:5px
}
.char .initial{
  width:58px;
  height:58px;
  border-radius:9px;
  background:#303746;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:700;
  font-size:20px;
  margin-bottom:5px
}
.char .meta{
  font-size:10px;
  color:var(--muted);
  margin-top:2px
}
.status{
  min-height:22px;
  color:var(--muted);
  font-size:13px;
  margin-top:12px
}
@media(max-width:850px){
  .teams{grid-template-columns:repeat(2,minmax(0,1fr))}
  .chars{grid-template-columns:repeat(5,minmax(0,1fr))}
}
@media(max-width:560px){
  main{padding:16px 10px 30px}
  h1{font-size:21px}
  .teams{grid-template-columns:1fr}
  .chars{grid-template-columns:repeat(4,minmax(0,1fr))}
  .slot{min-height:95px}
  .char{min-height:105px;font-size:11px}
  .char img{width:52px;height:52px}
  .slot img{width:52px;height:52px}
}
</style>
</head>

<body>
<main>

<h1>ゼンゼロ 9チーム編成ツール</h1>
<div class="sub">9チーム × 3人 / キャラ重複ルール付き</div>

<div class="notice">
通常キャラは1チームまで。
<strong>支援・防護のみ最大2チーム</strong>まで使用できます。
編成はこのブラウザに自動保存されます。
<br>
画像ファイルはこのHTMLと同じフォルダに置いてください。
</div>

<div class="toolbar">
<button id="reset" type="button">全リセット</button>
<button id="clearTeam" type="button">選択中チームを空にする</button>
</div>

<section id="teams" class="teams" aria-label="9チーム"></section>

<div class="filters">
<input id="search" type="search" placeholder="キャラ名を検索" aria-label="キャラ名を検索">

<select id="specialty" aria-label="特性">
<option value="all">全特性</option>
<option>強攻</option>
<option>撃破</option>
<option>異常</option>
<option>支援</option>
<option>防護</option>
<option>命破</option>
<option>鋭御</option>
</select>

<select id="rarity" aria-label="レアリティ">
<option value="all">全レアリティ</option>
<option value="S">S級</option>
<option value="A">A級</option>
<option value="∞">∞級</option>
</select>
</div>

<div id="count" class="count"></div>
<div id="chars" class="chars" aria-label="キャラクター一覧"></div>
<div id="status" class="status" aria-live="polite"></div>

</main>

