["6f351122be7781f8cd6f21722dd13661_2661769272105172713.webp","「11号」","強攻","S"],

["e0d2c585da7186984e2a1e66714131f8_348745644031971587.webp","猫宮又奈","強攻","S"],

["4f6da69b0ac332789cfa8f1a3db17e77_6866504406372735530.webp","ニコ・デマラ","支援","A"],

["3815b87d0e526b12127e69f5baed3fa7_2071488341033625974.webp","ビリー・キッド","強攻","A"],

["3db23765159cef54aecb564a310aa214_5875819227834946917.webp","アンビー・デマラ","撃破","A"]

];


/*
==========================================================
編成データ
==========================================================
*/

const STORAGE_KEY = "zzz-9-team-builder-v2";

let teams = load();
let active = 0;

const $ = id => document.getElementById(id);

const teamsEl = $("teams");
const charsEl = $("chars");
const statusEl = $("status");
const countEl = $("count");


/*
==========================================================
保存・読み込み
==========================================================
*/

function load(){
  try{
    const x = JSON.parse(localStorage.getItem(STORAGE_KEY));

    if(
      Array.isArray(x) &&
      x.length === 9 &&
      x.every(t => Array.isArray(t) && t.length === 3)
    ){
      return x;
    }

  }catch(e){}

  return Array.from(
    {length:9},
    () => [null,null,null]
  );
}

function save(){
  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(teams)
  );
}


/*
==========================================================
使用回数
==========================================================
*/

function maxUses(agent){

  return (
    agent[2] === "支援" ||
    agent[2] === "防護"
  ) ? 2 : 1;

}

function uses(name){

  return teams
    .flat()
    .filter(x => x && x[0] === name)
    .length;

}


/*
==========================================================
頭文字
==========================================================
*/

function initial(name){

  return name
    .replace(/[「」・＆&]/g,"")
    .slice(0,1);

}


/*
==========================================================
画像URL
==========================================================
*/

function imageUrl(agent){

  return IMAGE_BASE +
    encodeURIComponent(agent[0]);

}


/*
==========================================================
画像HTML
==========================================================
*/

function imageHTML(agent, className){

  const url = imageUrl(agent);

  const fallback =
    `this.style.display='none';` +
    `this.nextElementSibling.style.display='flex';`;

  return `
    <img
      class="${className}"
      src="${url}"
      alt="${agent[0]}"
      loading="lazy"
      onerror="${fallback}"
    >
    <div
      class="initial"
      style="display:none"
    >${initial(agent[0])}</div>
  `;

}


/*
==========================================================
キャラクター追加
==========================================================
*/

function addAgent(index){

  const agent = AGENTS[index];

  if(
    uses(agent[1]) >= maxUses(agent)
  ){
    return;
  }

  const slot =
    teams[active].findIndex(
      x => x === null
    );

  if(slot < 0){

    statusEl.textContent =
      `チーム${active+1}は満員です。` +
      `外したいキャラの枠をタップしてください。`;

    return;
  }

  teams[active][slot] = agent;

  save();

  statusEl.textContent =
    `${agent[1]}をチーム${active+1}に追加しました。`;

  render();

}


/*
==========================================================
チーム表示
==========================================================
*/

function renderTeams(){

  teamsEl.innerHTML = teams.map(
    (team, ti) => `

    <article class="team ${
      ti === active ? "active" : ""
    }">

      <div class="teamhead">

        <b>チーム${ti+1}</b>

        <button
          type="button"
          data-team="${ti}"
        >
          ${
            ti === active
              ? "選択中"
              : "選択"
          }
        </button>

      </div>

      <div class="slots">

        ${
          team.map(
            (agent, si) => agent
              ? `

                <button
                  type="button"
                  class="slot"
                  data-slot="${ti},${si}"
                  title="タップして外す"
                >

                  ${imageHTML(agent,"slotImage")}

                  <strong>
                    ${agent[1]}
                  </strong>

                  <span class="spec">
                    ${agent[2]} / ${agent[3]}級
                  </span>

                </button>

              `
              : `

                <button
                  type="button"
                  class="slot empty"
                  data-slot="${ti},${si}"
                >
                  空き
                </button>

              `
          ).join("")
        }

      </div>

    </article>

  `
  ).join("");


  teamsEl
    .querySelectorAll("[data-team]")
    .forEach(button => {

      button.addEventListener(
        "click",
        () => {

          active =
            Number(button.dataset.team);

          statusEl.textContent =
            `チーム${active+1}を選択中。`;

          render();

        }
      );

    });


  teamsEl
    .querySelectorAll("[data-slot]")
    .forEach(button => {

      button.addEventListener(
        "click",
        () => {

          const [ti,si] =
            button.dataset.slot
              .split(",")
              .map(Number);

          if(teams[ti][si]){

            const removed =
              teams[ti][si][1];

            teams[ti][si] = null;

            statusEl.textContent =
              `${removed}をチーム${ti+1}から外しました。`;

            save();
            render();

          }else{

            active = ti;

            statusEl.textContent =
              `チーム${active+1}を選択中。` +
              `キャラを選んでください。`;

            render();

          }

        }
      );

    });

}


/*
==========================================================
キャラクター一覧
==========================================================
*/

function renderChars(){

  const q =
    $("search")
      .value
      .trim()
      .toLowerCase();

  const sp =
    $("specialty").value;

  const rarity =
    $("rarity").value;


  const filtered =
    AGENTS
      .map((a,i) => ({a,i}))
      .filter(({a}) =>

        (
          !q ||
          a[1]
            .toLowerCase()
            .includes(q)
        )

        &&

        (
          sp === "all" ||
          a[2] === sp
        )

        &&

        (
          rarity === "all" ||
          a[3] === rarity
        )

      );


  countEl.textContent =
    `${filtered.length}人表示 / 全${AGENTS.length}人`;


  charsEl.innerHTML =
    filtered
      .map(({a,i}) => {

        const used =
          uses(a[1]);

        const max =
          maxUses(a);

        const disabled =
          used >= max;


        return `

          <button
            type="button"
            class="char ${
              disabled ? "used" : ""
            }"
            data-agent="${i}"
            ${disabled ? "disabled" : ""}
          >

            ${imageHTML(a,"charImage")}

            <strong>
              ${a[1]}
            </strong>

            <span class="meta">
              ${a[2]} / ${a[3]}級　
              ${used}/${max}
            </span>

          </button>

        `;

      })
      .join("");


  charsEl
    .querySelectorAll("[data-agent]")
    .forEach(button => {

      button.addEventListener(
        "click",
        () =>
          addAgent(
            Number(button.dataset.agent)
          )
      );

    });

}


/*
==========================================================
全体描画
==========================================================
*/

function render(){

  renderTeams();
  renderChars();

}


/*
==========================================================
検索・フィルター
==========================================================
*/

$("search")
  .addEventListener(
    "input",
    renderChars
  );

$("specialty")
  .addEventListener(
    "change",
    renderChars
  );

$("rarity")
  .addEventListener(
    "change",
    renderChars
  );


/*
==========================================================
リセット
==========================================================
*/

$("reset")
  .addEventListener(
    "click",
    () => {

      if(
        confirm(
          "9チームすべてをリセットしますか？"
        )
      ){

        teams =
          Array.from(
            {length:9},
            () => [null,null,null]
          );

        active = 0;

        save();

        statusEl.textContent =
          "すべてリセットしました。";

        render();

      }

    }
  );


/*
==========================================================
選択チームを空にする
==========================================================
*/

$("clearTeam")
  .addEventListener(
    "click",
    () => {

      teams[active] =
        [null,null,null];

      save();

      statusEl.textContent =
        `チーム${active+1}を空にしました。`;

      render();

    }
  );


/*
==========================================================
開始
==========================================================
*/

render();

statusEl.textContent =
  "チーム1を選択中。キャラをタップして編成してください。";

})();
</script>

